# glits root .env.example
# Copy this to .env and fill in your values
# These are used by the glits CLI for X (OAuth 1.0a consumer creds for user-context posting)

X_CONSUMER_KEY=your_x_oauth1_consumer_key_here
X_CONSUMER_SECRET=your_x_oauth1_consumer_secret_here

# KV storage for tokens (required for glits to read/write connected accounts)
# Get these from your Vercel KV dashboard
KV_REST_API_URL=https://your-kv.upstash.io
KV_REST_API_READ_ONLY_TOKEN=your_read_only_token_here

# Optional: full write token if doing writes from CLI (usually the web app uses the write one)
# KV_REST_API_TOKEN=your_full_write_token_here
