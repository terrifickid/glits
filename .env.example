# Vercel Blob — shared by CLI (send) and web (auth)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Web OAuth redirect base (production: your Vercel URL)
OAUTH_REDIRECT_BASE=https://your-app.vercel.app

# X (Twitter) — web auth + CLI token refresh on send
X_CLIENT_ID=
X_CLIENT_SECRET=

# Meta (Instagram, Threads, Facebook) — web auth only
META_APP_ID=
META_APP_SECRET=

# Google / YouTube — web auth + CLI token refresh on send
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn — web auth + CLI token refresh on send
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_VERSION=202505

# Nostr — glits bunker (web auth) + delegated signing (CLI send)
# Generate: npx nostr-tools demo (or any nsec generator)
NOSTR_BUNKER_NSEC=nsec1...
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net