# glits-web .env.example
# Copy to .env (or .env.local) for local development
# These are loaded by SvelteKit via $env/dynamic/private

# OAuth 1.0a credentials for X (consumer key/secret from X console Keys & Tokens > OAuth 1.0a section;
# required for 3-legged user auth to post on behalf of users. Callback URL must be registered in app settings.)
X_CONSUMER_KEY=your_x_oauth1_consumer_key_here
X_CONSUMER_SECRET=your_x_oauth1_consumer_secret_here

# KV storage (web app needs the full write token to save tokens after OAuth callback)
KV_REST_API_URL=https://your-kv.upstash.io
KV_REST_API_TOKEN=your_full_write_token_here

# Optional: force the redirect base (otherwise it auto-detects Vercel or falls back to localhost:5173)
# OAUTH_REDIRECT_BASE=https://your-deployed-glits-web.vercel.app

# You can add other platform client secrets here too as you enable them (LinkedIn, YouTube, etc.)

# Meta (Facebook Login) credentials — REQUIRED to connect Facebook Pages, Instagram Professional accounts, and Threads.
# These power the OAuth flows in glits-web for facebook/, instagram/, and threads/.
#
# How to obtain:
# 1. Go to https://developers.facebook.com/ and create a new app (choose Business or Other).
# 2. In the app dashboard, go to Settings > Basic.
# 3. Copy the App ID → META_APP_ID
# 4. Reveal and copy the App Secret → META_APP_SECRET
# 5. Add the "Facebook Login" product (and Instagram / Threads products as needed).
# 6. In Facebook Login > Settings, add your exact callback URLs to "Valid OAuth Redirect URIs":
#      https://your-deployed-site.com/auth/facebook/callback
#      https://your-deployed-site.com/auth/instagram/callback
#      https://your-deployed-site.com/auth/threads/callback
#    Also add the localhost versions for development:
#      http://localhost:5173/auth/facebook/callback  etc.
# 7. For development/testing with your own accounts you can stay in Development mode.
#    For other users or production, submit for App Review on the advanced permissions
#    (pages_manage_posts, instagram_business_content_publish, threads_content_publish, etc.).
#
# See the project instructions / this chat for the full detailed walkthrough.
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
